{
  "expo": {
    "name": "KZBU TECHNICIAN",
    "owner": "joshuasalabe",
    "slug": "kzbu-technical",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/kzbu.png",
    "scheme": [
      "kazibufast"
    ],
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kazibufast.kazi",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "tel",
          "telprompt",
          "sms",
          "mailto",
          "fb",
          "fbapi",
          "fbauth2",
          "fbshareextension",
          "fb-messenger-api",
          "fb-messenger-share-api",
          "fbmessenger",
          "fb-messenger",
          "whatsapp",
          "twitter",
          "twitterauth"
        ],
        "NSFaceIDUsageDescription": "This app uses Face ID for secure authentication",
        "NSCameraUsageDescription": "Allow KZBU TECHNICAL to access your camera"
      }
    },
    "android": {
      "package": "com.kazibufast.kazi",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/kzbu.png"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.CALL_PHONE",
        "android.permission.INTERNET",
        "android.permission.CAMERA"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "tel"
            },
            {
              "scheme": "mailto"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/kzbu.png"
    },
    "plugins": [
      "expo-router",
      "react-native-vision-camera",
      "expo-web-browser"
    ],
    "splash": {
      "image": "./assets/images/kzbu.png",
      "resizeMode": "contain",
      "backgroundColor": "#00AF9F",
      "light": {
        "image": "./assets/images/kzbu.png",
        "resizeMode": "contain",
        "backgroundColor": "#FFFFFF"
      },
      "dark": {
        "image": "./assets/images/kzbu.png",
        "resizeMode": "contain",
        "backgroundColor": "#000000"
      }
    },
    "assetBundlePatterns": [
      "*/"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "43ac0f90-bf85-4db0-bb31-d7ad6a049a5f"
      }
    }
  }
}
